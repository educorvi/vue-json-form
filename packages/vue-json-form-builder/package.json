{
    "name": "@educorvi/vue-json-form-builder",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/vue-json-form-builder.d.ts",
            "import": "./dist/vue-json-form-builder.js",
            "default": "./dist/vue-json-form-builder.js"
        },
        "./dist/*": "./dist/*"
    },
    "files": [
        "dist",
        "package.json",
        "README.md"
    ],
    "main": "dist/vue-json-form-builder.cjs",
    "module": "dist/vue-json-form-builder.js",
    "scripts": {
        "dev:internal": "vite -c vite.dev.config.ts --host",
        "dev": "turbo watch dev:internal",
        "build": "turbo build:internal check-types",
        "build:internal": "vue-tsc --noEmit && vite build",
        "check-types": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
        "preview": "vite preview",
        "test:unit": "vitest --run",
        "test:watch": "vitest",
        "format": "yarn run -T prettier --write src/",
        "format:check": "yarn run -T prettier --check src/",
        "lint": "yarn run -T eslint .",
        "lint:fix": "yarn run -T eslint . --fix",
        "prepack": "yarn run build"
    },
    "dependencies": {
        "@educorvi/vue-json-form": "workspace:^",
        "@educorvi/vue-json-form-ajv-validator": "workspace:^",
        "@phosphor-icons/vue": "^2.2.1",
        "@popperjs/core": "^2.11.8",
        "@vueuse/core": "^14.4.0",
        "bootstrap": "^5.3.8",
        "bootstrap-icons": "^1.13.1",
        "bootstrap-vue-next": "^0.45.7",
        "pinia": "^3.0.4",
        "pinia-plugin-persistedstate": "^4.7.1",
        "uuid": "^14.0.0",
        "vue": "^3.5.38",
        "vue-draggable-plus": "^0.6.1",
        "vue-router": "^5.1.0"
    },
    "devDependencies": {
        "@semantic-release/exec": "^7.1.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "prettier": "^3.8.3",
        "sass-embedded": "^1.100.0",
        "semantic-release": "^25.0.5",
        "semantic-release-monorepo": "^8.0.2",
        "semantic-release-yarn": "^3.0.2",
        "turbo": "^2.10.8",
        "typescript": "~6.0.3",
        "vite": "^8.0.16",
        "vite-plugin-dts": "^5.0.3",
        "vite-plugin-externalize-deps": "^0.10.0",
        "vitest": "^4.1.10",
        "vue-tsc": "^3.3.5"
    }
}
