{
    "name": "@educorvi/vue-json-forms-builder-schemas",
    "description": "Form element model (JSON Schema + UI Schema generation) for the Vue JSON Form Builder, with Yjs realtime-collaboration support",
    "version": "0.0.0",
    "type": "module",
    "dependencies": {
        "@educorvi/vue-json-form-schemas": "workspace:^",
        "yjs": "^13.6.27",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@semantic-release/exec": "^7.1.0",
        "@types/node": "^25.9.2",
        "semantic-release": "^25.0.5",
        "semantic-release-monorepo": "^8.0.2",
        "semantic-release-yarn": "^3.0.2",
        "tsdown": "^0.22.14",
        "turbo": "^2.10.8",
        "typescript": "~6.0.3",
        "vitest": "^4.1.10"
    },
    "exports": {
        ".": {
            "types": "./dist/vue-json-forms-builder-schemas.d.ts",
            "import": "./dist/vue-json-forms-builder-schemas.js",
            "default": "./dist/vue-json-forms-builder-schemas.js"
        },
        "./collab": {
            "types": "./dist/collab.d.ts",
            "import": "./dist/collab.js",
            "default": "./dist/collab.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "module": "./dist/vue-json-forms-builder-schemas.js",
    "packageManager": "yarn@4.4.0",
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/educorvi/vue-json-form.git",
        "directory": "packages/vue.json-form-builder-schemas"
    },
    "scripts": {
        "build": "turbo build:internal check-types",
        "build:internal": "tsdown",
        "check-types": "tsc --noEmit",
        "lint": "yarn run -T eslint .",
        "lint:fix": "yarn run -T eslint . --fix",
        "prepack": "yarn run build",
        "test:unit": "vitest --run"
    },
    "sideEffects": false
}
