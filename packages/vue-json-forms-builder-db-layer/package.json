{
    "name": "@educorvi/vue-json-forms-builder-db-layer",
    "devDependencies": {
        "@types/node": "^26.2.0",
        "tsdown": "^0.22.14",
        "turbo": "^2.10.8",
        "typescript": "^6.0.0"
    },
    "scripts": {
        "build": "turbo build:internal check-types",
        "build:internal": "tsdown --config tsdown.config.mts",
        "check-types": "tsc --noEmit",
        "lint": "yarn run -T eslint .",
        "lint:fix": "yarn run -T eslint . --fix",
        "prepack": "yarn run build"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        }
    },
    "dependencies": {
        "reflect-metadata": "^0.2.2",
        "typeorm": "1.0"
    }
}
