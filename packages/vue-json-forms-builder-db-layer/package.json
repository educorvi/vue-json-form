{
    "name": "@educorvi/vue-json-forms-builder-db-layer",
    "devDependencies": {
        "@types/node": "^26.2.0",
        "turbo": "^2.10.8",
        "typescript": "^6.0.0",
        "vite": "^8.2.1",
        "vite-plugin-dts": "^5.0.3",
        "vite-plugin-externalize-deps": "^0.10.0"
    },
    "scripts": {
        "build": "turbo build:internal check-types",
        "build:internal": "vite build",
        "check-types": "tsc --noEmit",
