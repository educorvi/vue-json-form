{
    "name": "@educorvi/vue-json-forms-builder-orpc-contract",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./contract": {
            "types": "./dist/contract.d.ts",
            "import": "./dist/contract.js",
            "default": "./dist/contract.js"
        },
        "./contract-with-errors": {
            "types": "./dist/contract-with-errors.d.ts",
            "import": "./dist/contract-with-errors.js",
            "default": "./dist/contract-with-errors.js"
        },
        "./generated/orpc.gen": {
            "types": "./dist/generated/orpc.gen.d.ts",
            "import": "./dist/generated/orpc.gen.js",
            "default": "./dist/generated/orpc.gen.js"
        },
        "./generated/zod.gen": {
            "types": "./dist/generated/zod.gen.d.ts",
            "import": "./dist/generated/zod.gen.js",
            "default": "./dist/generated/zod.gen.js"
        }
    },
    "files": [
        "dist",
        "package.json",
        "README.md"
    ],
    "scripts": {
        "build": "turbo build:internal check-types",
        "build:internal": "yarn orpg:generate && tsdown",
        "check-types": "tsc --noEmit",
        "orpg:generate": "openapi-ts",
        "prepack": "yarn run build"
    },
    "dependencies": {
        "@orpc/contract": "^1.15.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@hey-api/openapi-ts": "0.99.0",
        "@types/node": "^26.2.0",
        "tsdown": "^0.22.14",
        "turbo": "^2.10.12",
        "typescript": "~6.0.3"
    }
}
