# nuxt-auth-utils session cookie encryption (any random string, keep it secret)
NUXT_SESSION_PASSWORD=4d2KqPv8sR7wT3xL9mZcN6hJ5bFgE1uY
# Session cookie name — MUST differ from the backend's "nuxt-session":
# both apps run on localhost and cookies ignore ports, so a shared name
# would let the backend overwrite this app's session cookie (and vice
# versa). Defaults to external-app-session when unset.
NUXT_SESSION_NAME=external-app-session

# --- Keycloak (external-keycloak, the external identity provider this app logs in against) ---
# The client must be created in the external Keycloak admin console first, see README.md
# ("Create the client in Keycloak"). Afterwards, export the realm:
#   cd ../json-forms-builder && ./export-realm.sh external-keycloak
NUXT_OAUTH_KEYCLOAK_CLIENT_ID=external-example-app
NUXT_OAUTH_KEYCLOAK_CLIENT_SECRET=<paste the client secret from the external Keycloak admin console>
NUXT_OAUTH_KEYCLOAK_SERVER_URL=http://external-keycloak.localhost:8081
NUXT_OAUTH_KEYCLOAK_REALM=dev

# --- Form-builder webcomponent auth (main app's Keycloak kc1) ---
# The webcomponent logs in directly against kc1 with keycloak-js: PUBLIC
# client "vueformbuilder-embed" (created in keycloak/dev/dev-realm.json),
# PKCE, silent check-sso on mount. kc_idp_hint = the identity-provider
# alias in kc1 that brokers the external Keycloak, so the login skips the
# kc1 login page and the user is authenticated seamlessly when they
# already have an external Keycloak SSO session.
NUXT_PUBLIC_KC_URL=http://kc1.localhost:8080
NUXT_PUBLIC_KC_REALM=dev
NUXT_PUBLIC_KC_CLIENT_ID=vueformbuilder-embed
NUXT_PUBLIC_KC_IDP_HINT=external-oidc-example

# --- Realtime collaboration (form loading) ---
# Hocuspocus collab server of the backend (run `yarn dev:collab` in
# apps/json-forms-builder). The builder loads the form over this websocket:
# document name = the form's numeric id. The websocket handshake carries
# the kc1 access token obtained by keycloak-js (Authorization: Bearer),
# which the backend validates via JWKS.
NUXT_PUBLIC_COLLAB_URL=ws://localhost:1234
