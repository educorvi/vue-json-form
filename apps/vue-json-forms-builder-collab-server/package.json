{
    "name": "vue-json-forms-builder-collab-server",
    "type": "module",
    "packageManager": "yarn@4.18.0",
    "devDependencies": {
        "@types/node": "^26.2.0",
        "tsdown": "^0.22.14",
        "tsx": "^4.22.4",
        "turbo": "^2.10.12",
        "typescript": "~6.0.3",
        "vitest": "^4.1.10"
    },
    "scripts": {
        "dev": "turbo watch dev:internal",
        "dev:internal": "tsx watch --tsconfig tsconfig.json src/index.ts",
        "start": "tsx --tsconfig tsconfig.json src/index.ts",
        "build": "turbo build:internal",
        "build:internal": "tsdown",
        "check-types": "tsc --noEmit",
        "test:unit": "vitest --run"
    },
    "dependencies": {
        "@educorvi/vue-json-forms-builder-db-layer": "workspace:^",
        "@educorvi/vue-json-forms-builder-orpc-contract": "workspace:^",
        "@educorvi/vue-json-forms-builder-schemas": "workspace:^",
        "@hocuspocus/provider": "^4.6.0",
        "@hocuspocus/server": "^4.6.0",
        "@orpc/client": "^1.15.0",
        "@orpc/contract": "^1.15.0",
        "@orpc/openapi-client": "^1.15.0",
        "dotenv": "^17.4.2",
        "pg": "^8.22.0",
        "reflect-metadata": "^0.2.2",
        "y-protocols": "^1.0.7",
        "yjs": "^13.6.32",
        "zod": "^4.4.3"
    }
}
