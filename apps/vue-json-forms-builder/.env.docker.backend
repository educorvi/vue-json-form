# PostgreSQL (the `postgres` compose service, port 5432 inside the network)
DB_HOST=postgres
DB_PORT=5432
DB_USER=form_builder
DB_PASSWORD=form_builder
# Dedicated test database (created by docker/init-test-db.sh on first start)
DB_NAME=form_builder_test

NODE_ENV=development

NUXT_SESSION_PASSWORD=743e6775b56d41b8a2ec0ffe36b630eb

NUXT_OAUTH_KEYCLOAK_CLIENT_ID=vueformbuilder
NUXT_OAUTH_KEYCLOAK_CLIENT_SECRET=Y2tJJ2Ik2CnJjpfY8FUxLiusbn4tEO9F
NUXT_OAUTH_KEYCLOAK_SERVER_URL=http://kc1.localhost:8080
NUXT_OAUTH_KEYCLOAK_REALM=dev

# Allowed external apps embedding the form-builder webcomponent, e.g. the containerized demo app. Comma seperated
NUXT_AUTH_ALLOWED_REDIRECT_ORIGINS=http://external-example-app.localhost:3001

# Keycloak client ids whose access tokens are accepted as bearer auth (server/lib/jwt-auth.ts) — incl. the PUBLIC embed client of the webcomponent (keycloak-js silent check-sso).
NUXT_AUTH_ALLOWED_CLIENT_IDS=vueformbuilder,vueformbuilder-embed

NUXT_PUBLIC_COLLAB_URL=ws://localhost:1234
