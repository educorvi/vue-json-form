# PostgreSQL (the `postgres` compose service, port 5432 inside the network)
DB_HOST=postgres
DB_PORT=5432
DB_USER=form_builder
DB_PASSWORD=form_builder
DB_NAME=form_builder_test

NODE_ENV=development

COLLAB_NUXT_URL=http://app:3000
COLLAB_PORT=1234

# Browser origins allowed to open a collab WebSocket connection
COLLAB_ALLOWED_ORIGINS=http://localhost:3000,http://external-example-app.localhost:3001,http://localhost:5173
