# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5433
DB_USER=form_builder
DB_PASSWORD=form_builder
DB_NAME=form_builder

# Hocuspocus realtime collaboration server (yarn dev:collab) that the form
# builder connects to. Uncomment to enable collaboration in the UI.
# NUXT_PUBLIC_COLLAB_URL=ws://ws.localhost:1234

# Set to 'development' to enable TypeORM query logging
NODE_ENV=development

NUXT_SESSION_PASSWORD=eo63GViugo4FM7tgV54PvQS45T9f582U

NUXT_OAUTH_KEYCLOAK_CLIENT_ID=vueformbuilder
NUXT_OAUTH_KEYCLOAK_CLIENT_SECRET=Y2tJJ2Ik2CnJjpfY8FUxLiusbn4tEO9F
NUXT_OAUTH_KEYCLOAK_SERVER_URL=http://localhost:8080
NUXT_OAUTH_KEYCLOAK_REALM=dev

# Origins allowed as `?redirect=` target after /auth/keycloak login
# (comma-separated). Needed by external apps embedding the form-builder
# webcomponent, e.g. the demo app apps/vue-json-forms-builder-external-example.
NUXT_AUTH_ALLOWED_REDIRECT_ORIGINS=http://external-example-app.localhost:3001

# Keycloak client ids whose ACCESS TOKENS are accepted as bearer auth
# (azp/aud check in server/lib/jwt-auth.ts) — needed for the PUBLIC embed
# client "vueformbuilder-embed" that the webcomponent logs in with via
# keycloak-js (silent check-sso). Empty = only the OIDC client above is
# accepted. The public client is created by the realm import
# (keycloak/dev/dev-realm.json).
NUXT_AUTH_ALLOWED_CLIENT_IDS=vueformbuilder,vueformbuilder-embed

# Uncomment to point the server at the dedicated test database (created
# alongside the dev DB, see docker/init-test-db.sh) instead of DB_NAME above,
# e.g. when running integration tests. See tests/integration/README.md.
# DB_NAME=form_builder_test

