{
    "name": "vue-json-forms-builder-external-example",
    "type": "module",
    "private": true,
    "scripts": {
        "build": "turbo build:internal check-types",
        "build:internal": "yarn sync:silent-check-sso && nuxt build",
        "check-types": "npx nuxt typecheck",
        "dev": "turbo watch dev:internal",
        "dev:internal": "yarn sync:silent-check-sso && nuxt dev",
        "postinstall": "nuxt prepare",
        "preview": "nuxt preview",
        "generate": "nuxt generate",
        "lint": "yarn run -T eslint .",
        "lint:fix": "yarn run -T eslint . --fix",
        "test:e2e": "playwright test",
        "sync:silent-check-sso": "cp ../../packages/vue-json-forms-builder-webcomponent/public/silent-check-sso.html public/"
    },
    "dependencies": {
        "@bootstrap-vue-next/nuxt": "^0.45.7",
        "bootstrap": "^5.3.8",
        "bootstrap-icons": "^1.13.1",
        "bootstrap-vue-next": "^0.45.7",
        "nuxt": "^4.5.2",
        "nuxt-auth-utils": "^0.5.30",
        "vue": "^3.5.41",
        "vue-router": "^5.1.0"
    },
    "devDependencies": {
        "@educorvi/vue-json-forms-builder-test-support": "workspace:^",
        "@educorvi/vue-json-forms-builder-webcomponent": "workspace:^",
        "@nuxt/eslint": "^1.16.0",
        "@playwright/test": "^1.61.0",
        "@types/bootstrap": "^5",
        "turbo": "^2.10.12",
        "typescript": "~6.0.3",
        "vue-tsc": "^3.3.5"
    },
    "engines": {
        "node": "^22.18.0 || >=24.12.0"
    }
}
