{
    "name": "json-forms-builder",
    "type": "module",
    "private": true,
    "scripts": {
        "build": "turbo build:internal check-types",
        "build:internal": "nuxt build",
        "check-types": "npx nuxt typecheck",
        "dev:internal": "nuxt dev",
        "dev": "turbo watch dev:internal",
        "dev:collab": "tsx watch --tsconfig collab-server/tsconfig.json collab-server/index.ts",
        "smoke:collab": "tsx collab-server/smoke-client.ts",
        "test:collab": "tsx collab-server/live-sync-test.ts",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "openapi:export": "curl -s http://localhost:3000/_openapi.json | tee public/openapi.json",
        "orpg:generate": "openapi-ts",
        "lint": "yarn run -T eslint .",
        "lint:fix": "yarn run -T eslint . --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:unit": "vitest run --project=unit --project=component --project=nuxt",
        "test:integration": "vitest run --project=integration",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:debug": "playwright test --debug"
    },
    "dependencies": {
        "@bootstrap-vue-next/nuxt": "^0.45.7",
        "@educorvi/vue-json-form": "workspace:^",
        "@educorvi/vue-json-form-ajv-validator": "workspace:^",
        "@educorvi/vue-json-form-builder": "workspace:*",
        "@educorvi/vue-json-form-builder-schemas": "workspace:^",
        "@hocuspocus/server": "^4.6.0",
        "@iconify-json/ph": "^1.2.2",
        "@nuxt/icon": "^2.4.1",
        "@nuxtjs/i18n": "^10.4.0",
        "@orpc/client": "^1.14.6",
        "@orpc/json-schema": "^1.14.6",
        "@orpc/openapi": "^1.14.6",
        "@orpc/server": "^1.14.6",
        "@orpc/zod": "^1.14.6",
        "@pinia/nuxt": "0.11.3",
        "bootstrap": "^5.3.8",
        "bootstrap-vue-next": "^0.45.7",
        "jose": "^6.2.3",
        "module": "^2.0.0",
        "nuxi": "^3.36.1",
        "nuxt": "^4.4.8",
        "nuxt-auth-utils": "^0.5.29",
        "pg": "^8.22.0",
        "pinia": "^3.0.4",
        "turbo": "^2.10.8",
        "typeorm": "1.0",
        "vue": "^3.5.38",
        "vue-router": "^5.1.0",
        "y-protocols": "^1.0.7",
        "yjs": "^13.6.27",
        "zod": "^4.4.3",
        "zod-openapi": "^6.0.0"
    },
    "devDependencies": {
        "@hey-api/openapi-ts": "0.99.0",
        "@nuxt/eslint": "^1.16.0",
        "@nuxt/test-utils": "^4.1.0",
        "@playwright/test": "^1.61.0",
        "@types/bootstrap": "^5",
        "@types/pg": "^8",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vitest/coverage-v8": "^4.1.10",
        "@vue/test-utils": "^2.4.11",
        "happy-dom": "^20.11.1",
        "tsx": "^4.22.4",
        "vitest": "^4.1.10"
    }
}
